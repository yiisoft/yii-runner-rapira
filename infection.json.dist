{
    "testFramework": "testo",
    "testFrameworkOptions": "--group=!acceptance",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "php:\/\/stderr",
        "stryker": {
            "report": "master"
        }
    },
    "mutators": {
        "@default": true
    }
}
